# Copy to .env, replace the password, and run chmod 600 .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
AURORA_HTTP_PORT=8088

# Enable only for first-owner registration during initial setup; disable immediately after.
AURORA_BOOTSTRAP_ENABLED=false

# Optional AI provider configuration. Leave empty to disable model execution.
# Provider quotas and free-model availability can change; calls may incur charges.
AURORA_AI_API_KEY=
AURORA_AI_MODEL=openrouter/free
AURORA_AI_BASE_URL=https://openrouter.ai/api/v1
# Maximum counted member requests per workspace per UTC month. Each agent stage counts as one call; OWNER/ADMIN bypass this application cap.
AURORA_AI_MONTHLY_REQUEST_LIMIT=100

# Optional Gmail SMTP invitation delivery using a Google App Password.
AURORA_MAIL_ENABLED=false
AURORA_MAIL_HOST=smtp.gmail.com
AURORA_MAIL_PORT=587
AURORA_MAIL_FROM=
AURORA_MAIL_USERNAME=
AURORA_MAIL_PASSWORD=
# Public dashboard URL used to construct invitation links.
AURORA_APP_BASE_URL=http://localhost:8088

# Never commit a real .env file or API credentials.
# Optional hard AI spend guard (USD). Set a monthly platform ceiling and a defensible
# maximum cost for one provider request before enabling the ceiling.
AURORA_AI_PLATFORM_MONTHLY_BUDGET_USD=0
AURORA_AI_MAX_REQUEST_RESERVATION_USD=0

# Optional public HTTPS ingress (requires DNS A/AAAA records pointing to this host
# and inbound TCP 80/443 plus UDP 443 where supported). Start with:
# docker compose --profile public up -d
AURORA_DOMAIN=aurora.example.com
